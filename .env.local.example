# Vercel KV (Upstash) - set in Vercel project settings for prod
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Protects the cron endpoint (Vercel sends this as the Authorization bearer)
CRON_SECRET=
# Metaculus community-forecast API (free personal token: metaculus.com Settings -> API).
# Server-only - do NOT prefix NEXT_PUBLIC_. Absent -> the forecasts tab degrades to unavailable.
METACULUS_TOKEN=
